# Base16 Embers Light - micro color scheme
# Scheme by Jannik Siebert (https://github.com/janniks)

color-link default "#433b32,#dbd6d1"

color-link comment "#8a8075"

color-link constant "#828257"
color-link constant.specialChar "#825757"
color-link constant.string "#57826d"

color-link identifier "#826d57"
color-link identifier.class "#6d8257"

color-link preproc "#6d8257"

color-link special "#576d82"

color-link statement "#826d57"

color-link symbol.operator "#433b32"
color-link symbol.tag "#433b32"

color-link type "#6d8257"

color-link underlined "#826d57"

color-link error "bold #dbd6d1,#826d57"
color-link todo "bold #6d8257,#beb6ae"
color-link hlsearch "#beb6ae,#6d8257"
color-link statusline "#5a5047,#a39a90"
color-link tabbar "#8a8075,#beb6ae"
color-link indent-char "#8a8075"
color-link line-number "#8a8075,#beb6ae"
color-link current-line-number "#5a5047,#beb6ae"

color-link diff-added "#57826d,#beb6ae"
color-link diff-modified "#8a8075,#beb6ae"
color-link diff-deleted "#826d57,#beb6ae"
color-link gutter-error "#826d57,#beb6ae"
color-link gutter-warning "#6d5782,#beb6ae"

color-link cursor-line "#beb6ae"
color-link color-column "#beb6ae"
