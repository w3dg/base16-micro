# Base16 Everforest Light (Soft) - micro color scheme
# Scheme by Márcio Sobel (https://github.com/marciosobel)

color-link default "#5c6a72,#f3ead3"

color-link comment "#939f91"

color-link constant "#f57d26"
color-link constant.specialChar "#829181"
color-link constant.string "#8da101"

color-link identifier "#f85552"
color-link identifier.class "#dfa000"

color-link preproc "#dfa000"

color-link special "#35a77c"

color-link statement "#f85552"

color-link symbol.operator "#5c6a72"
color-link symbol.tag "#5c6a72"

color-link type "#dfa000"

color-link underlined "#f85552"

color-link error "bold #f3ead3,#f85552"
color-link todo "bold #dfa000,#eae4ca"
color-link hlsearch "#eae4ca,#dfa000"
color-link statusline "#829181,#ddd8be"
color-link tabbar "#939f91,#eae4ca"
color-link indent-char "#939f91"
color-link line-number "#939f91,#eae4ca"
color-link current-line-number "#829181,#eae4ca"

color-link diff-added "#8da101,#eae4ca"
color-link diff-modified "#939f91,#eae4ca"
color-link diff-deleted "#f85552,#eae4ca"
color-link gutter-error "#f85552,#eae4ca"
color-link gutter-warning "#3a94c5,#eae4ca"

color-link cursor-line "#eae4ca"
color-link color-column "#eae4ca"
