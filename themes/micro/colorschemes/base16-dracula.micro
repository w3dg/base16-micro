# Base16 Dracula - micro color scheme
# Scheme by clach04 (https://github.com/clach04)

color-link default "#f8f8f2,#282a36"

color-link comment "#6272a4"

color-link constant "#ffb86c"
color-link constant.specialChar "#993333"
color-link constant.string "#50fa7b"

color-link identifier "#ff5555"
color-link identifier.class "#f1fa8c"

color-link preproc "#f1fa8c"

color-link special "#8be9fd"

color-link statement "#ff5555"

color-link symbol.operator "#f8f8f2"
color-link symbol.tag "#f8f8f2"

color-link type "#f1fa8c"

color-link underlined "#ff5555"

color-link error "bold #282a36,#ff5555"
color-link todo "bold #f1fa8c,#21222c"
color-link hlsearch "#21222c,#f1fa8c"
color-link statusline "#9ea8c7,#44475a"
color-link tabbar "#6272a4,#21222c"
color-link indent-char "#6272a4"
color-link line-number "#6272a4,#21222c"
color-link current-line-number "#9ea8c7,#21222c"

color-link diff-added "#50fa7b,#21222c"
color-link diff-modified "#6272a4,#21222c"
color-link diff-deleted "#ff5555,#21222c"
color-link gutter-error "#ff5555,#21222c"
color-link gutter-warning "#bd93f9,#21222c"

color-link cursor-line "#21222c"
color-link color-column "#21222c"
