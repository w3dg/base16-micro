# Base16 Ayu Light - micro color scheme
# Scheme by Tinted Theming (https://github.com/tinted-theming), Ayu Theme (https://github.com/ayu-theme)

color-link default "#5c6166,#f8f9fa"

color-link comment "#a0a6ac"

color-link constant "#fa8d3e"
color-link constant.specialChar "#e6ba7e"
color-link constant.string "#6cbf49"

color-link identifier "#f07171"
color-link identifier.class "#f2ae49"

color-link preproc "#f2ae49"

color-link special "#4cbf99"

color-link statement "#f07171"

color-link symbol.operator "#5c6166"
color-link symbol.tag "#5c6166"

color-link type "#f2ae49"

color-link underlined "#f07171"

color-link error "bold #f8f9fa,#f07171"
color-link todo "bold #f2ae49,#edeff1"
color-link hlsearch "#edeff1,#f2ae49"
color-link statusline "#8a9199,#d2d4d8"
color-link tabbar "#a0a6ac,#edeff1"
color-link indent-char "#a0a6ac"
color-link line-number "#a0a6ac,#edeff1"
color-link current-line-number "#8a9199,#edeff1"

color-link diff-added "#6cbf49,#edeff1"
color-link diff-modified "#a0a6ac,#edeff1"
color-link diff-deleted "#f07171,#edeff1"
color-link gutter-error "#f07171,#edeff1"
color-link gutter-warning "#399ee6,#edeff1"

color-link cursor-line "#edeff1"
color-link color-column "#edeff1"
