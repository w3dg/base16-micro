# Base16 Oxocarbon Light - micro color scheme
# Scheme by shaunsingh/IBM, Tinted Theming (https://github.com/tinted-theming)

color-link default "#525f70,#f2f4f8"

color-link comment "#a1acba"

color-link constant "#ee5396"
color-link constant.specialChar "#803800"
color-link constant.string "#42be65"

color-link identifier "#ff7eb6"
color-link identifier.class "#ff6f00"

color-link preproc "#ff6f00"

color-link special "#673ab7"

color-link statement "#ff7eb6"

color-link symbol.operator "#525f70"
color-link symbol.tag "#525f70"

color-link type "#ff6f00"

color-link underlined "#ff7eb6"

color-link error "bold #f2f4f8,#ff7eb6"
color-link todo "bold #ff6f00,#dde1e6"
color-link hlsearch "#dde1e6,#ff6f00"
color-link statusline "#68788d,#bec6cf"
color-link tabbar "#a1acba,#dde1e6"
color-link indent-char "#a1acba"
color-link line-number "#a1acba,#dde1e6"
color-link current-line-number "#68788d,#dde1e6"

color-link diff-added "#42be65,#dde1e6"
color-link diff-modified "#a1acba,#dde1e6"
color-link diff-deleted "#ff7eb6,#dde1e6"
color-link gutter-error "#ff7eb6,#dde1e6"
color-link gutter-warning "#0f62fe,#dde1e6"

color-link cursor-line "#dde1e6"
color-link color-column "#dde1e6"
