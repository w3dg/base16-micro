# Base16 Kanagawa Dragon - micro color scheme
# Scheme by Stefan Weigl-Bosker (https://github.com/sweiglbosker), Tommaso Laurenzi (https://github.com/rebelot/kanagawa.nvim)

color-link default "#c5c9c5,#181616"

color-link comment "#625e5a"

color-link constant "#b6927b"
color-link constant.specialChar "#b98d7b"
color-link constant.string "#8a9a7b"

color-link identifier "#c4746e"
color-link identifier.class "#c4b28a"

color-link preproc "#c4b28a"

color-link special "#8ea4a2"

color-link statement "#c4746e"

color-link symbol.operator "#c5c9c5"
color-link symbol.tag "#c5c9c5"

color-link type "#c4b28a"

color-link underlined "#c4746e"

color-link error "bold #181616,#c4746e"
color-link todo "bold #c4b28a,#282727"
color-link hlsearch "#282727,#c4b28a"
color-link statusline "#737c73,#393836"
color-link tabbar "#625e5a,#282727"
color-link indent-char "#625e5a"
color-link line-number "#625e5a,#282727"
color-link current-line-number "#737c73,#282727"

color-link diff-added "#8a9a7b,#282727"
color-link diff-modified "#625e5a,#282727"
color-link diff-deleted "#c4746e,#282727"
color-link gutter-error "#c4746e,#282727"
color-link gutter-warning "#8ba4b0,#282727"

color-link cursor-line "#282727"
color-link color-column "#282727"
