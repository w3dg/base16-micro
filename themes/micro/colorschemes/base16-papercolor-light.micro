# Base16 PaperColor Light - micro color scheme
# Scheme by Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)

color-link default "#5e5e5e,#eeeeee"

color-link comment "#858585"

color-link constant "#d75f00"
color-link constant.specialChar "#af0000"
color-link constant.string "#008700"

color-link identifier "#d70000"
color-link identifier.class "#d75f00"

color-link preproc "#d75f00"

color-link special "#0087af"

color-link statement "#d70000"

color-link symbol.operator "#5e5e5e"
color-link symbol.tag "#5e5e5e"

color-link type "#d75f00"

color-link underlined "#d70000"

color-link error "bold #eeeeee,#d70000"
color-link todo "bold #d75f00,#c4c4c4"
color-link hlsearch "#c4c4c4,#d75f00"
color-link statusline "#6b6b6b,#9e9e9e"
color-link tabbar "#858585,#c4c4c4"
color-link indent-char "#858585"
color-link line-number "#858585,#c4c4c4"
color-link current-line-number "#6b6b6b,#c4c4c4"

color-link diff-added "#008700,#c4c4c4"
color-link diff-modified "#858585,#c4c4c4"
color-link diff-deleted "#d70000,#c4c4c4"
color-link gutter-error "#d70000,#c4c4c4"
color-link gutter-warning "#005f87,#c4c4c4"

color-link cursor-line "#c4c4c4"
color-link color-column "#c4c4c4"
