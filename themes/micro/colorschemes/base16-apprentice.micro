# Base16 Apprentice - micro color scheme
# Scheme by Romain Lafourcade (https://github.com/romainl)

color-link default "#bcbcbc,#262626"

color-link comment "#444444"

color-link constant "#ff8700"
color-link constant.specialChar "#af5f5f"
color-link constant.string "#5f875f"

color-link identifier "#af5f5f"
color-link identifier.class "#87875f"

color-link preproc "#87875f"

color-link special "#5f8787"

color-link statement "#af5f5f"

color-link symbol.operator "#bcbcbc"
color-link symbol.tag "#bcbcbc"

color-link type "#87875f"

color-link underlined "#af5f5f"

color-link error "bold #262626,#af5f5f"
color-link todo "bold #87875f,#303030"
color-link hlsearch "#303030,#87875f"
color-link statusline "#6c6c6c,#3a3a3a"
color-link tabbar "#444444,#303030"
color-link indent-char "#444444"
color-link line-number "#444444,#303030"
color-link current-line-number "#6c6c6c,#303030"

color-link diff-added "#5f875f,#303030"
color-link diff-modified "#444444,#303030"
color-link diff-deleted "#af5f5f,#303030"
color-link gutter-error "#af5f5f,#303030"
color-link gutter-warning "#5f87af,#303030"

color-link cursor-line "#303030"
color-link color-column "#303030"
