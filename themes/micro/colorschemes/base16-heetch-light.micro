# Base16 Heetch Light - micro color scheme
# Scheme by Geoffrey Teale (tealeg@gmail.com), Tinted Theming (https://github.com/tinted-theming)

color-link default "#5a496e,#feffff"

color-link comment "#9c92a8"

color-link constant "#bd0152"
color-link constant.specialChar "#58425d"
color-link constant.string "#5bb66a"

color-link identifier "#f80059"
color-link identifier.class "#bd9701"

color-link preproc "#bd9701"

color-link special "#47f9f5"

color-link statement "#f80059"

color-link symbol.operator "#5a496e"
color-link symbol.tag "#5a496e"

color-link type "#bd9701"

color-link underlined "#f80059"

color-link error "bold #feffff,#f80059"
color-link todo "bold #bd9701,#dedae2"
color-link hlsearch "#dedae2,#bd9701"
color-link statusline "#7b6d8b,#bdb6c5"
color-link tabbar "#9c92a8,#dedae2"
color-link indent-char "#9c92a8"
color-link line-number "#9c92a8,#dedae2"
color-link current-line-number "#7b6d8b,#dedae2"

color-link diff-added "#5bb66a,#dedae2"
color-link diff-modified "#9c92a8,#dedae2"
color-link diff-deleted "#f80059,#dedae2"
color-link gutter-error "#f80059,#dedae2"
color-link gutter-warning "#5ba2b6,#dedae2"

color-link cursor-line "#dedae2"
color-link color-column "#dedae2"
