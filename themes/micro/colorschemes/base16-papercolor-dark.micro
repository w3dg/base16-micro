# Base16 PaperColor Dark - micro color scheme
# Scheme by Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)

color-link default "#9e9e9e,#1c1c1c"

color-link comment "#585858"

color-link constant "#d7af5f"
color-link constant.specialChar "#af005f"
color-link constant.string "#5faf5f"

color-link identifier "#ff5faf"
color-link identifier.class "#ffaf00"

color-link preproc "#ffaf00"

color-link special "#00afaf"

color-link statement "#ff5faf"

color-link symbol.operator "#9e9e9e"
color-link symbol.tag "#9e9e9e"

color-link type "#ffaf00"

color-link underlined "#ff5faf"

color-link error "bold #1c1c1c,#ff5faf"
color-link todo "bold #ffaf00,#363636"
color-link hlsearch "#363636,#ffaf00"
color-link statusline "#808080,#424242"
color-link tabbar "#585858,#363636"
color-link indent-char "#585858"
color-link line-number "#585858,#363636"
color-link current-line-number "#808080,#363636"

color-link diff-added "#5faf5f,#363636"
color-link diff-modified "#585858,#363636"
color-link diff-deleted "#ff5faf,#363636"
color-link gutter-error "#ff5faf,#363636"
color-link gutter-warning "#5fafd7,#363636"

color-link cursor-line "#363636"
color-link color-column "#363636"
