# Base16 Sequoia Retro Light - micro color scheme
# Scheme by Micheal Andreuzza (https://michaelandreuzza.com/)

color-link default "#282930,#edeef2"

color-link comment "#565760"

color-link constant "#5f7982"
color-link constant.specialChar "#4a704e"
color-link constant.string "#4a704e"

color-link identifier "#5f7982"
color-link identifier.class "#bf5238"

color-link preproc "#bf5238"

color-link special "#8a6539"

color-link statement "#5f7982"

color-link symbol.operator "#282930"
color-link symbol.tag "#282930"

color-link type "#bf5238"

color-link underlined "#5f7982"

color-link error "bold #edeef2,#5f7982"
color-link todo "bold #bf5238,#e2e3e8"
color-link hlsearch "#e2e3e8,#bf5238"
color-link statusline "#42434e,#e2e3e8"
color-link tabbar "#565760,#e2e3e8"
color-link indent-char "#565760"
color-link line-number "#565760,#e2e3e8"
color-link current-line-number "#42434e,#e2e3e8"

color-link diff-added "#4a704e,#e2e3e8"
color-link diff-modified "#565760,#e2e3e8"
color-link diff-deleted "#5f7982,#e2e3e8"
color-link gutter-error "#5f7982,#e2e3e8"
color-link gutter-warning "#456a82,#e2e3e8"

color-link cursor-line "#e2e3e8"
color-link color-column "#e2e3e8"
