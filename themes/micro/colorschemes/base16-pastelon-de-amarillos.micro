# Base16 Pastelón de Amarillos - micro color scheme
# Scheme by Richard Martinez (https://sonofmartinus.com)

color-link default "#432c3b,#fff4d6"

color-link comment "#80616b"

color-link constant "#ad570f"
color-link constant.specialChar "#7c3528"
color-link constant.string "#167451"

color-link identifier "#bd3548"
color-link identifier.class "#946400"

color-link preproc "#946400"

color-link special "#007270"

color-link statement "#bd3548"

color-link symbol.operator "#432c3b"
color-link symbol.tag "#432c3b"

color-link type "#946400"

color-link underlined "#bd3548"

color-link error "bold #fff4d6,#bd3548"
color-link todo "bold #946400,#f2d083"
color-link hlsearch "#f2d083,#946400"
color-link statusline "#684653,#d69b45"
color-link tabbar "#80616b,#f2d083"
color-link indent-char "#80616b"
color-link line-number "#80616b,#f2d083"
color-link current-line-number "#684653,#f2d083"

color-link diff-added "#167451,#f2d083"
color-link diff-modified "#80616b,#f2d083"
color-link diff-deleted "#bd3548,#f2d083"
color-link gutter-error "#bd3548,#f2d083"
color-link gutter-warning "#1e5da8,#f2d083"

color-link cursor-line "#f2d083"
color-link color-column "#f2d083"
