# Base16 Sequoia Retro Dark - micro color scheme
# Scheme by Micheal Andreuzza (https://michaelandreuzza.com/)

color-link default "#868690,#0f1014"

color-link comment "#43444d"

color-link constant "#829fa7"
color-link constant.specialChar "#648f68"
color-link constant.string "#648f68"

color-link identifier "#829fa7"
color-link identifier.class "#da674b"

color-link preproc "#da674b"

color-link special "#a27e57"

color-link statement "#829fa7"

color-link symbol.operator "#868690"
color-link symbol.tag "#868690"

color-link type "#da674b"

color-link underlined "#829fa7"

color-link error "bold #0f1014,#829fa7"
color-link todo "bold #da674b,#111216"
color-link hlsearch "#111216,#da674b"
color-link statusline "#575861,#111216"
color-link tabbar "#43444d,#111216"
color-link indent-char "#43444d"
color-link line-number "#43444d,#111216"
color-link current-line-number "#575861,#111216"

color-link diff-added "#648f68,#111216"
color-link diff-modified "#43444d,#111216"
color-link diff-deleted "#829fa7,#111216"
color-link gutter-error "#829fa7,#111216"
color-link gutter-warning "#5c87a4,#111216"

color-link cursor-line "#111216"
color-link color-column "#111216"
