# Base16 Bogota - micro color scheme
# Scheme by xscriptor (https://github.com/xscriptor)

color-link default "#f7f1ff,#200b0a"

color-link comment "#525053"

color-link constant "#fea78b"
color-link constant.specialChar "#b0705e"
color-link constant.string "#7bd88f"

color-link identifier "#fc618d"
color-link identifier.class "#ffed89"

color-link preproc "#ffed89"

color-link special "#47e6ff"

color-link statement "#fc618d"

color-link symbol.operator "#f7f1ff"
color-link symbol.tag "#f7f1ff"

color-link type "#ffed89"

color-link underlined "#fc618d"

color-link error "bold #200b0a,#fc618d"
color-link todo "bold #ffed89,#2f1b1b"
color-link hlsearch "#2f1b1b,#ffed89"
color-link statusline "#968a91,#3a2727"
color-link tabbar "#525053,#2f1b1b"
color-link indent-char "#525053"
color-link line-number "#525053,#2f1b1b"
color-link current-line-number "#968a91,#2f1b1b"

color-link diff-added "#7bd88f,#2f1b1b"
color-link diff-modified "#525053,#2f1b1b"
color-link diff-deleted "#fc618d,#2f1b1b"
color-link gutter-error "#fc618d,#2f1b1b"
color-link gutter-warning "#47e6ff,#2f1b1b"

color-link cursor-line "#2f1b1b"
color-link color-column "#2f1b1b"
