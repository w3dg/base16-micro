# Base16 Madrid - micro color scheme
# Scheme by xscriptor (https://github.com/xscriptor)

color-link default "#1a1a1a,#fafafa"

color-link comment "#4d4d4d"

color-link constant "#923217"
color-link constant.specialChar "#662310"
color-link constant.string "#007a28"

color-link identifier "#990026"
color-link identifier.class "#8a6408"

color-link preproc "#8a6408"

color-link special "#007a9e"

color-link statement "#990026"

color-link symbol.operator "#1a1a1a"
color-link symbol.tag "#1a1a1a"

color-link type "#8a6408"

color-link underlined "#990026"

color-link error "bold #fafafa,#990026"
color-link todo "bold #8a6408,#eaeaea"
color-link hlsearch "#eaeaea,#8a6408"
color-link statusline "#686868,#dfdfdf"
color-link tabbar "#4d4d4d,#eaeaea"
color-link indent-char "#4d4d4d"
color-link line-number "#4d4d4d,#eaeaea"
color-link current-line-number "#686868,#eaeaea"

color-link diff-added "#007a28,#eaeaea"
color-link diff-modified "#4d4d4d,#eaeaea"
color-link diff-deleted "#990026,#eaeaea"
color-link gutter-error "#990026,#eaeaea"
color-link gutter-warning "#007a9e,#eaeaea"

color-link cursor-line "#eaeaea"
color-link color-column "#eaeaea"
