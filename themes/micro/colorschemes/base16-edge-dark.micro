# Base16 Edge Dark - micro color scheme
# Scheme by cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)

color-link default "#afb2b5,#262729"

color-link comment "#4a4c4f"

color-link constant "#eba31a"
color-link constant.specialChar "#5ebaa5"
color-link constant.string "#a1bf78"

color-link identifier "#e77171"
color-link identifier.class "#dbb774"

color-link preproc "#dbb774"

color-link special "#5ebaa5"

color-link statement "#e77171"

color-link symbol.operator "#afb2b5"
color-link symbol.tag "#afb2b5"

color-link type "#dbb774"

color-link underlined "#e77171"

color-link error "bold #262729,#e77171"
color-link todo "bold #dbb774,#313235"
color-link hlsearch "#313235,#dbb774"
color-link statusline "#95989d,#3d3f42"
color-link tabbar "#4a4c4f,#313235"
color-link indent-char "#4a4c4f"
color-link line-number "#4a4c4f,#313235"
color-link current-line-number "#95989d,#313235"

color-link diff-added "#a1bf78,#313235"
color-link diff-modified "#4a4c4f,#313235"
color-link diff-deleted "#e77171,#313235"
color-link gutter-error "#e77171,#313235"
color-link gutter-warning "#73b3e7,#313235"

color-link cursor-line "#313235"
color-link color-column "#313235"
