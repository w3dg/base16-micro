# Base16 Charcoal Light - micro color scheme
# Scheme by Mubin Muhammad (https://github.com/mubin6th)

color-link default "#382e1b,#cabda0"

color-link comment "#645538"

color-link constant "#110e06"
color-link constant.specialChar "#4b3e26"
color-link constant.string "#110e06"

color-link identifier "#382e1b"
color-link identifier.class "#110e06"

color-link preproc "#110e06"

color-link special "#110e06"

color-link statement "#382e1b"

color-link symbol.operator "#382e1b"
color-link symbol.tag "#382e1b"

color-link type "#110e06"

color-link underlined "#382e1b"

color-link error "bold #cabda0,#382e1b"
color-link todo "bold #110e06,#bcad8c"
color-link hlsearch "#bcad8c,#110e06"
color-link statusline "#110e06,#af9f7d"
color-link tabbar "#645538,#bcad8c"
color-link indent-char "#645538"
color-link line-number "#645538,#bcad8c"
color-link current-line-number "#110e06,#bcad8c"

color-link diff-added "#110e06,#bcad8c"
color-link diff-modified "#645538,#bcad8c"
color-link diff-deleted "#382e1b,#bcad8c"
color-link gutter-error "#382e1b,#bcad8c"
color-link gutter-warning "#251e0f,#bcad8c"

color-link cursor-line "#bcad8c"
color-link color-column "#bcad8c"
