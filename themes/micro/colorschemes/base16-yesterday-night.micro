# Base16 Yesterday Night - micro color scheme
# Scheme by FroZnShiva (https://github.com/FroZnShiva)

color-link default "#dfe1e8,#343d46"

color-link comment "#a7adba"

color-link constant "#de935f"
color-link constant.specialChar "#a3685a"
color-link constant.string "#b5bd68"

color-link identifier "#cc6666"
color-link identifier.class "#f0c674"

color-link preproc "#f0c674"

color-link special "#8abeb7"

color-link statement "#cc6666"

color-link symbol.operator "#dfe1e8"
color-link symbol.tag "#dfe1e8"

color-link type "#f0c674"

color-link underlined "#cc6666"

color-link error "bold #343d46,#cc6666"
color-link todo "bold #f0c674,#4f5b66"
color-link hlsearch "#4f5b66,#f0c674"
color-link statusline "#c0c5ce,#65737e"
color-link tabbar "#a7adba,#4f5b66"
color-link indent-char "#a7adba"
color-link line-number "#a7adba,#4f5b66"
color-link current-line-number "#c0c5ce,#4f5b66"

color-link diff-added "#b5bd68,#4f5b66"
color-link diff-modified "#a7adba,#4f5b66"
color-link diff-deleted "#cc6666,#4f5b66"
color-link gutter-error "#cc6666,#4f5b66"
color-link gutter-warning "#81a2be,#4f5b66"

color-link cursor-line "#4f5b66"
color-link color-column "#4f5b66"
