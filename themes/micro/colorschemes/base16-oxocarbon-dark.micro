# Base16 Oxocarbon Dark - micro color scheme
# Scheme by shaunsingh/IBM, Tinted Theming (https://github.com/tinted-theming)

color-link default "#f2f4f8,#161616"

color-link comment "#525252"

color-link constant "#ff7eb6"
color-link constant.specialChar "#82cfff"
color-link constant.string "#42be65"

color-link identifier "#ee5396"
color-link identifier.class "#ff6f00"

color-link preproc "#ff6f00"

color-link special "#3ddbd9"

color-link statement "#ee5396"

color-link symbol.operator "#f2f4f8"
color-link symbol.tag "#f2f4f8"

color-link type "#ff6f00"

color-link underlined "#ee5396"

color-link error "bold #161616,#ee5396"
color-link todo "bold #ff6f00,#262626"
color-link hlsearch "#262626,#ff6f00"
color-link statusline "#dde1e6,#393939"
color-link tabbar "#525252,#262626"
color-link indent-char "#525252"
color-link line-number "#525252,#262626"
color-link current-line-number "#dde1e6,#262626"

color-link diff-added "#42be65,#262626"
color-link diff-modified "#525252,#262626"
color-link diff-deleted "#ee5396,#262626"
color-link gutter-error "#ee5396,#262626"
color-link gutter-warning "#33b1ff,#262626"

color-link cursor-line "#262626"
color-link color-column "#262626"
